* text=auto

# cmd.exe needs CRLF in batch files; bash needs LF in shell scripts.
*.bat     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf

# Keep the "Download ZIP" folder for annotators free of developer files.
/.github        export-ignore
/tests          export-ignore
/tools          export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
